ENVIRONMENT=development
LOG_LEVEL=INFO
# Production MUST set DEV_AUTH_BYPASS=false (and NEXT_PUBLIC_DEV_AUTH=false).
DEV_AUTH_BYPASS=true
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
JWT_ISSUER=http://keycloak:8080/realms/safelytold
# Production: JWT_ISSUER must equal the public Keycloak realm URL Keycloak actually
# advertises, e.g. https://auth.safelytold.com/realms/safelytold (see KEYCLOAK_PUBLIC_URL).
JWT_AUDIENCE=safelytold-api
# Public URL browsers use for staff OIDC login (production: https://auth.safelytold.com).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# Public base URL Keycloak advertises behind the reverse proxy (production: https://auth.safelytold.com).
KEYCLOAK_PUBLIC_URL=http://keycloak:8080
# Header mode for Keycloak behind a TLS-terminating proxy (production: xforwarded).
KEYCLOAK_PROXY_HEADERS=none
POSTGRES_USER=safelytold
POSTGRES_PASSWORD=safelytold_dev_only
VAULT_DB_PASSWORD=vault_dev_only
AUDIT_DB_PASSWORD=audit_dev_only
RABBITMQ_USER=safelytold
RABBITMQ_PASSWORD=safelytold_dev_only
RABBITMQ_ERLANG_COOKIE=safelytold_erlang_cookie_dev_change_me
RABBITMQ_URL=amqp://safelytold:safelytold_dev_only@rabbitmq:5672/%2F
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
PREFECT_API_URL=http://prefect-server:4200/api
OPA_URL=http://opa:8181
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=safelytold
S3_SECRET_KEY=safelytold_dev_only_change_me
S3_EVIDENCE_BUCKET=safelytold-evidence
CLAMAV_HOST=clamav
AUDIT_SIGNING_KEY=development-only-change-me
REPORTER_PEPPER=development-only-change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
GRAFANA_ADMIN_PASSWORD=admin_dev_only
# Comma-separated emails with superuser access (platform admin + AI run review).
ADMIN_SUPERUSER_EMAILS=michael.kateregga@datasqan.com
BLOCKCHAIN_MODE=database
BLOCKCHAIN_RPC_URL=http://anvil:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
# AI_PROVIDER options: openai | mock. Production MUST be openai; mock is a dev-only stub.
AI_PROVIDER=openai
AI_ALLOW_RAW_EVIDENCE=false
# Public URL the browser uses to reach the API (production: https://safelytold.com).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8101
# Comma-separated browser origins the API gateway CORS allows (production: https://safelytold.com).
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
# NEXT_PUBLIC_DEV_AUTH=true enables the development-only login button (production: false).
NEXT_PUBLIC_DEV_AUTH=true

# Neutral notification email. MESSAGING_PROVIDER options: log | mailcatcher | smtp.
MESSAGING_PROVIDER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

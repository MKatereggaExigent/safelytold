ENVIRONMENT=development
LOG_LEVEL=INFO
# Compose default is false (secure). Set true ONLY for local development.
DEV_AUTH_BYPASS=false
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
JWT_ISSUER=http://keycloak:8080/realms/safelytold
# Production: JWT_ISSUER must equal the public Keycloak realm URL Keycloak actually
# advertises, e.g. https://auth.safelytold.com/realms/safelytold (see KEYCLOAK_PUBLIC_URL).
JWT_AUDIENCE=safelytold-api
# Public URL browsers use for staff OIDC login (production: https://auth.safelytold.com).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# Public base URL Keycloak advertises behind the reverse proxy (production: https://auth.safelytold.com).
KEYCLOAK_PUBLIC_URL=http://keycloak:8080
# Header mode for Keycloak behind a TLS-terminating proxy (production: xforwarded).
KEYCLOAK_PROXY_HEADERS=xforwarded
POSTGRES_USER=safelytold
POSTGRES_PASSWORD=safelytold_dev_only
VAULT_DB_PASSWORD=vault_dev_only
AUDIT_DB_PASSWORD=audit_dev_only
RABBITMQ_USER=safelytold
RABBITMQ_PASSWORD=safelytold_dev_only
RABBITMQ_ERLANG_COOKIE=safelytold_erlang_cookie_dev_change_me
RABBITMQ_URL=amqp://safelytold:safelytold_dev_only@rabbitmq:5672/%2F
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
PREFECT_API_URL=http://prefect-server:4200/api
OPA_URL=http://opa:8181
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=safelytold
S3_SECRET_KEY=safelytold_dev_only_change_me
S3_EVIDENCE_BUCKET=safelytold-evidence
CLAMAV_HOST=clamav
AUDIT_SIGNING_KEY=development-only-change-me
REPORTER_PEPPER=development-only-change-me
# HS256 secret that signs anonymous/confidential reporter mailbox tokens
# (reporter-identity issuance and mailbox verification share this). Production MUST set a strong value.
REPORTER_JWT_SECRET=development-only-change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only
GRAFANA_ADMIN_PASSWORD=admin_dev_only
# Comma-separated emails with superuser access (platform admin + AI run review).
ADMIN_SUPERUSER_EMAILS=michael.kateregga@datasqan.com
# JSON list of tenants auto-provisioned on tenancy-service boot (config/env seed).
# Each entry's "id" is the stable tenant_id used by Keycloak claims and RLS, so
# pick UUIDs once and never change them. Set to [] to disable.
# Example:
# SEED_TENANTS=[{"id":"00000000-0000-0000-0000-000000000001","slug":"safelytold","display_name":"SafelyTold","home_region":"za"},{"id":"a1b2c3d4-0000-0000-0000-000000000101","slug":"example-customer","display_name":"Example Customer","home_region":"za"}]
SEED_TENANTS=[]
# Isolated synthetic investor/client demonstration tenant. Provisioning is
# explicit; setting this ID alone creates no account and grants no privileges.
DEMO_TENANT_ID=d3a00000-0000-4000-8000-000000000001
# Demo uses production code paths; configure non-delivering sandbox provider
# credentials and a sandbox ledger chain/database rather than disabling logic.
DEMO_NOTIFICATION_PROVIDER=sandbox
DEMO_HOTLINE_PROVIDER=sandbox
DEMO_BLOCKCHAIN_PROVIDER=sandbox
# Demo credentials are operator-supplied secrets; never commit their values.
DEMO_USER_PASSWORD=
DEMO_ACCOUNT_EXPIRES_AT=
# Short-lived bearer tokens are supplied only at provisioning time.
DEMO_ADMIN_ACCESS_TOKEN=
DEMO_SEED_ACCESS_TOKEN=
# BLOCKCHAIN_MODE=database stores Merkle roots in PostgreSQL only. Use evm for
# on-chain anchoring via IntegrityAnchor.sol (requires RPC, contract + signer below).
BLOCKCHAIN_MODE=database
BLOCKCHAIN_RPC_URL=http://anvil:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
# Optional shared secret that lets the workflow worker anchor batches
# (X-Anchor-Token header). Unset = staff JWT auth only.
BLOCKCHAIN_ANCHOR_TOKEN=
BLOCKCHAIN_LEDGER_URL=http://blockchain-ledger-service:8028
BLOCKCHAIN_GAS_LIMIT=250000
BLOCKCHAIN_MAX_FEE_GWEI=2
BLOCKCHAIN_PRIORITY_FEE_GWEI=1
# AI_PROVIDER options: openai | mock. Production MUST be openai; mock is a dev-only stub.
AI_PROVIDER=openai
AI_ALLOW_RAW_EVIDENCE=false
# Public URL the browser uses to reach the API (production: https://safelytold.com).
# The gateway client appends /v1/gateway/{service}/... itself, so NEVER include
# a /v1 suffix here (e.g. https://safelytold.com/v1/ would double-prefix and 404).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8101
# Comma-separated browser origins the API gateway CORS allows (production: https://safelytold.com).
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
# NEXT_PUBLIC_DEV_AUTH=true enables the development-only login button (default: false).
NEXT_PUBLIC_DEV_AUTH=false

# Neutral notification email. MESSAGING_PROVIDER options: log | mailcatcher | smtp.
MESSAGING_PROVIDER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Production reporting-channel configuration. CHANNEL_WEBHOOK_SECRET must be a
# random 32+ byte secret shared only with the contracted email/hotline provider.
REPORTING_EMAIL_ADDRESS=
TOLL_FREE_NUMBER=
RECEIVING_PROVIDER_NAME=
CHANNEL_WEBHOOK_SECRET=
INTAKE_SERVICE_URL=http://intake-service:8014
REPORTER_IDENTITY_SERVICE_URL=http://reporter-identity-service:8012

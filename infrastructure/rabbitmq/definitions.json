{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "safelytold",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "safelytold.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "safelytold.events.dlx",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "safelytold.dead-letter",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    }
  ],
  "bindings": [
    {
      "source": "safelytold.events.dlx",
      "vhost": "/",
      "destination": "safelytold.dead-letter",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}

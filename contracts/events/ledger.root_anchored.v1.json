{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workpoliticscop.example/events/ledger.root_anchored.v1.json",
  "title": "ledger.root_anchored.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "tenant_id",
    "correlation_id",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "ledger.root_anchored.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "batch_id",
        "root_kind",
        "merkle_root",
        "leaf_count",
        "transaction_hash"
      ],
      "properties": {
        "anchor_id": {
          "type": "string",
          "format": "uuid"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "root_kind": {
          "type": "string"
        },
        "merkle_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "leaf_count": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_hash": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workpoliticscop.example/events/operations.record.changed.v1.json",
  "title": "operations.record.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "tenant_id", "correlation_id", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "source": {"type": "string", "minLength": 1},
    "type": {"const": "operations.record.changed.v1"},
    "subject": {"type": "string", "minLength": 1},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "area", "previous_status", "status"],
      "properties": {
        "record_id": {"type": "string", "format": "uuid"},
        "area": {"enum": ["awareness", "training", "qa", "continuity", "coverage", "hotline", "reporting"]},
        "previous_status": {"type": "string"},
        "status": {"type": "string"}
      }
    }
  }
}

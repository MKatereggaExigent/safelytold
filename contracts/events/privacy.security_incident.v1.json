{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workpoliticscop.example/events/privacy.security_incident.v1.json",
  "title": "privacy.security_incident.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "tenant_id",
    "correlation_id",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "privacy.security_incident.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "severity",
        "detected_at",
        "affected_service"
      ],
      "properties": {
        "incident_id": {
          "type": "string",
          "format": "uuid"
        },
        "severity": {
          "type": "string"
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "affected_service": {
          "type": "string"
        }
      }
    }
  }
}

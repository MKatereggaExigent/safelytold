{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.workpoliticscop.example/events/evidence.sanitised.v1.json",
  "title": "evidence.sanitised.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "tenant_id",
    "correlation_id",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "evidence.sanitised.v1"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "case_id",
        "derivative_id",
        "sha256",
        "sanitisation_status"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "derivative_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sanitisation_status": {
          "type": "string"
        }
      }
    }
  }
}
